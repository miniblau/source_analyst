{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "description": "One record per case in the briefing, in the order given.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "vuln_class",
          "status",
          "confidence",
          "evidence",
          "case",
          "reasoning",
          "seed"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 400
          },
          "vuln_class": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "investigating",
              "needs_proof",
              "refuted",
              "inconclusive"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "case": {
            "type": "string",
            "maxLength": 300
          },
          "reasoning": {
            "type": "string",
            "maxLength": 1200
          },
          "seed": {
            "type": "string",
            "maxLength": 200,
            "description": "seed hypothesis matched, or empty"
          }
        }
      },
      "maxItems": 64
    }
  }
}
